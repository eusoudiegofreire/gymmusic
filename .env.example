# =============================================================
# Gym Music IA — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local no repositório.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
# URL do seu projeto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon) — segura para expor no browser
# (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave service_role — NUNCA expor no browser ou em código client-side
# (Project Settings > API > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────
# Chave secreta da API Stripe — NUNCA expor no browser
# (Stripe Dashboard > Developers > API keys > Secret key)
STRIPE_SECRET_KEY=sk_live_...

# Secret para verificar assinatura dos webhooks do Stripe
# (Stripe Dashboard > Developers > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID do plano Básico — R$97/mês
# (Stripe Dashboard > Products > Plano Básico > Price ID)
STRIPE_PRICE_BASICO=price_...

# Price ID do plano Pro — R$197/mês
# (Stripe Dashboard > Products > Plano Pro > Price ID)
STRIPE_PRICE_PRO=price_...

# ── Aplicação ─────────────────────────────────────────────────
# URL pública da aplicação — usada nos redirects do Stripe Checkout
# Em produção: https://seudominio.com.br
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://gymmusic.com.br

# UUID do usuário administrador no Supabase Auth
# (Supabase Dashboard > Authentication > Users > copie o UUID)
ADMIN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
